# check.health environment configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# ── Flask ──────────────────────────────────────────────────────────────────
# Generate with: python manage_users.py secret
SECRET_KEY=change-me-in-production
FLASK_ENV=development

# Session lifetime (seconds). Default: 1 hour sliding, 10 hours absolute.
# PERMANENT_SESSION_LIFETIME=3600
# SESSION_ABSOLUTE_LIFETIME=36000

# ── Check Point Provider-1 / MDS appliances ────────────────────────────────
# These are tried in order for HA failover when collecting domain data.
# Do NOT include SmartEvent appliances here — they do not manage domains.
CP_MDS_PRIMARY=10.x.x.x
CP_MDS_PRIMARY_LABEL=HQ MDS (Provider-1)
# Optional: second MDS site (e.g. Colo / DR)
# CP_MDS_3=10.x.x.x
# CP_MDS_3_LABEL=Colo MDS (Provider-1)

CP_API_KEY=your-read-only-api-key-here
# Set to false for self-signed certificates (typical in lab/enterprise)
CP_VERIFY_SSL=false
# Timeout in seconds for MDS API calls
CP_TIMEOUT=30

# ── Check Point SmartEvent appliances ──────────────────────────────────────
# Shown in a separate "SmartEvent" section on the dashboard.
# Health is determined by TCP reachability + optional API login.
CP_SE_1=10.x.x.x
CP_SE_1_LABEL=HQ SmartEvent
# CP_SE_2=10.x.x.x
# CP_SE_2_LABEL=Colo SmartEvent

# ── Log Servers (MLS) ──────────────────────────────────────────────────────
# TCP/443 reachability check only.
# CP_MLS_1=10.x.x.x
# CP_MLS_2=10.x.x.x
# CP_MLS_1_LABEL=MLS Primary
# CP_MLS_2_LABEL=MLS Secondary

# ── Health thresholds ──────────────────────────────────────────────────────
CPU_WARN=70
CPU_CRIT=90
MEM_WARN=75
MEM_CRIT=90
